---
import "../styles/global.css";
import SmoothScroll from "../components/SmoothScroll.jsx";
import Cursor from "../components/Cursor.jsx";
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.astro";
import { DISCIPLINES } from "../data/disciplines.js";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "CALTEC — Calibration Technology Services. Traceable calibration, instrumentation support and validation for organisations where accuracy, uptime and audit readiness matter." } = Astro.props;
const canonical = Astro.url;

/* destination names for the transition overlay */
const pageNames: Record<string, string> = {
  "/": "Home",
  "/about/": "About",
  "/services/": "Services",
  "/process/": "Process",
  "/certification/": "Certification",
  "/certificates/": "Certification",
  "/blog/": "Blog",
  "/enquiry/": "Enquiry",
  "/contact-us/": "Contact",
  "/contact/": "Contact",
  "/business-profile/": "Profile",
  "/privacy-policy/": "Privacy",
};
for (const d of DISCIPLINES) pageNames[`/${d.slug}/`] = d.name;
const currentPage = pageNames[Astro.url.pathname] ?? "Caltec";
const namespace = Astro.url.pathname.replace(/^\/|\/$/g, "").replace(/\//g, "-") || "home";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        document.documentElement.classList.add("js");
        if (sessionStorage.getItem("caltec_v")) document.documentElement.classList.add("returning");
      } catch (e) {}
    </script>
    <noscript><style>#loader, #wipe { display: none !important; }</style></noscript>
  </head>
  <body data-barba="wrapper">
    {/* ── loading screen: dot + cycling greetings (first visit) ── */}
    <div id="loader" aria-hidden="true">
      <div class="loader-center">
        <span class="l-dot"></span>
        <span class="l-word" id="load-word">Hello</span>
      </div>
    </div>

    {/* ── page transition wipe: dot + destination name (persistent) ── */}
    <div id="wipe" aria-hidden="true">
      <div class="wipe-center">
        <span class="l-dot"></span>
        <span class="l-word" id="wipe-word">{currentPage}</span>
      </div>
    </div>

    <script type="application/json" id="barba-names">{JSON.stringify(pageNames)}</script>

    <SmoothScroll client:load />
    <Cursor client:load />
    <div class="grain" aria-hidden="true"></div>
    <Navbar client:load />
    <main
      data-barba="container"
      data-barba-namespace={namespace}
      data-page-name={currentPage}
      data-title={title}
      data-description={description}
    >
      <slot />
    </main>
    <Footer />

    {/* first-visit loader + hard-load wipe reveal */}
    <script is:inline define:vars={{ currentPage }}>
      (function () {
        var EASE_IO = "cubic-bezier(0.76, 0, 0.24, 1)";
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var loader = document.getElementById("loader");
        var wipe = document.getElementById("wipe");
        var loadWord = document.getElementById("load-word");
        var wipeWord = document.getElementById("wipe-word");
        var returning = document.documentElement.classList.contains("returning");
        var GREETINGS = ["Hello", "Bonjour", "\u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0947", "Ciao", "Ol\u00e1", "\u304a\u3044", "Hall\u00e5", "Guten tag", "Hallo"];
        window.__firstLoad = true;

        function lockScroll(on) {
          document.body.style.overflow = on ? "hidden" : "";
          try {
            if (window.__lenis) on ? window.__lenis.stop() : window.__lenis.start();
          } catch (e) {}
        }

        function finish() {
          try { sessionStorage.setItem("caltec_v", "1"); } catch (e) {}
          lockScroll(false);
          if (loader) loader.style.display = "none";
          if (wipe) {
            wipe.style.transform = "translateY(101%)";
            wipe.style.borderTopLeftRadius = "0";
            wipe.style.borderTopRightRadius = "0";
            wipe.style.borderBottomLeftRadius = "0";
            wipe.style.borderBottomRightRadius = "0";
          }
          if (wipeWord) { wipeWord.style.opacity = "1"; wipeWord.textContent = currentPage; }
          window.__firstLoad = false;
        }

        function setWord(el, text) {
          if (!el || reduced) { if (el) el.textContent = text; return; }
          el.animate(
            [
              { opacity: 1, transform: "translateY(0)", filter: "blur(0)" },
              { opacity: 0, transform: "translateY(-40%)", filter: "blur(6px)" }
            ],
            { duration: 120, easing: "ease-in", fill: "forwards" }
          ).onfinish = function () {
            el.textContent = text;
            el.animate(
              [
                { opacity: 0, transform: "translateY(40%)", filter: "blur(6px)" },
                { opacity: 1, transform: "translateY(0)", filter: "blur(0)" }
              ],
              { duration: 160, easing: "ease-out", fill: "forwards" }
            );
          };
        }

        /* hard load within a session: wipe starts covering, lift it away */
        function wipeAway() {
          if (!wipe || reduced) { finish(); return; }
          if (wipeWord) {
            wipeWord.textContent = currentPage;
            wipeWord.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 400, easing: "ease-in", fill: "forwards" });
          }
          wipe.animate(
            [
              { transform: "translateY(0)", borderBottomLeftRadius: "50% 10vh", borderBottomRightRadius: "50% 10vh" },
              { transform: "translateY(-101%)", borderBottomLeftRadius: "50% 0vh", borderBottomRightRadius: "50% 0vh" }
            ],
            { duration: 800, easing: EASE_IO, fill: "forwards" }
          ).onfinish = finish;
        }

        /* first visit: greeting cycle, then lift away */
        function runLoader() {
          if (!loader || reduced) { finish(); return; }
          lockScroll(true);
          var i = 0;
          setWord(loadWord, GREETINGS[0]);
          var iv = setInterval(function () {
            i++;
            if (i < GREETINGS.length) {
              setWord(loadWord, GREETINGS[i]);
            } else {
              clearInterval(iv);
              setTimeout(function () {
                if (loadWord) loadWord.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 400, easing: "ease-in", fill: "forwards" });
                setTimeout(function () {
                  loader.animate(
                    [
                      { transform: "translateY(0)", borderBottomLeftRadius: "50% 10vh", borderBottomRightRadius: "50% 10vh" },
                      { transform: "translateY(-101%)", borderBottomLeftRadius: "50% 0vh", borderBottomRightRadius: "50% 0vh" }
                    ],
                    { duration: 800, easing: EASE_IO, fill: "forwards" }
                  ).onfinish = finish;
                }, 350);
              }, 350);
            }
          }, 300);
        }

        window.addEventListener("pageshow", function (e) {
          if (e.persisted) finish();
        });

        setTimeout(finish, 8000);

        if (returning) {
          lockScroll(true);
          if (document.readyState === "complete") wipeAway();
          else window.addEventListener("load", wipeAway);
          setTimeout(function () { if (loader && loader.style.display !== "none") wipeAway(); }, 3000);
        } else {
          if (document.readyState === "complete") runLoader();
          else window.addEventListener("load", runLoader);
        }
      })();
    </script>

    {/* Barba.js page transitions — no full reloads, wipe covers + reveals */}
    <script>
      import barba from "@barba/core";
      import barbaPrefetch from "@barba/prefetch";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);
      barba.use(barbaPrefetch);

      const EASE_IN = "cubic-bezier(0.77, 0, 0.175, 1)"; /* Power4.easeIn */
      const EASE_IO = "cubic-bezier(0.76, 0, 0.24, 1)";
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const wipe = document.getElementById("wipe");
      const wipeWord = document.getElementById("wipe-word");
      let pageNames = {};
      try {
        pageNames = JSON.parse(document.getElementById("barba-names").textContent || "{}");
      } catch (e) {}

      function nameFor(path) {
        if (pageNames[path]) return pageNames[path];
        const slug = (path.replace(/^\/|\/$/g, "").split("/").pop() || "");
        return slug.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ") || "Caltec";
      }

      function pathOf(href) {
        try {
          return new URL(href, window.location.origin).pathname;
        } catch (e) {
          return "/";
        }
      }

      /* kill scroll-driven animation state from the outgoing page */
      function killPageAnimations() {
        try {
          ScrollTrigger.getAll().forEach((t) => {
            if (t.animation) t.animation.kill();
            t.kill();
          });
        } catch (e) {}
      }

      function resetWipe() {
        if (!wipe) return;
        wipe.style.transform = "translateY(101%)";
        wipe.style.borderTopLeftRadius = "0";
        wipe.style.borderTopRightRadius = "0";
        wipe.style.borderBottomLeftRadius = "0";
        wipe.style.borderBottomRightRadius = "0";
        if (wipeWord) wipeWord.style.opacity = "1";
      }

      function finished(anim) {
        return anim.finished.catch(() => {});
      }

      barba.init({
        timeout: 8000,
        prevent: ({ el }) => {
          const href = el.getAttribute("href") || "";
          return href.startsWith("#") || el.hasAttribute("data-barba-prevent");
        },
        transitions: [
          {
            name: "wipe",
            async leave(data) {
              if (reduced || !wipe) return;
              window.__barbaNav = true;
              if (wipeWord) wipeWord.textContent = nameFor(pathOf(data.next.url.href));
              try {
                if (window.__lenis) window.__lenis.stop();
              } catch (e) {}
              document.body.style.overflow = "hidden";
              killPageAnimations();
              await finished(
                wipe.animate(
                  [
                    { transform: "translateY(101%)", borderTopLeftRadius: "50% 0vh", borderTopRightRadius: "50% 0vh" },
                    { transform: "translateY(0)", borderTopLeftRadius: "50% 10vh", borderTopRightRadius: "50% 10vh" }
                  ],
                  { duration: 500, easing: EASE_IN, fill: "forwards" }
                )
              );
            },
            async enter(data) {
              const c = data.next.container;
              if (c.dataset.title) document.title = c.dataset.title;
              const md = document.querySelector('meta[name="description"]');
              if (md && c.dataset.description) md.setAttribute("content", c.dataset.description);
              const cn = document.querySelector('link[rel="canonical"]');
              if (cn) cn.setAttribute("href", data.next.url.href);
              try {
                if (window.__lenis) window.__lenis.scrollTo(0, { immediate: true });
              } catch (e) {}
              window.scrollTo(0, 0);
              if (!wipe || reduced) {
                document.body.style.overflow = "";
                try {
                  if (window.__lenis) window.__lenis.start();
                } catch (e) {}
                return;
              }
              if (wipeWord) {
                await finished(
                  wipeWord.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 250, easing: "ease-in", fill: "forwards" })
                );
              }
              await finished(
                wipe.animate(
                  [
                    { transform: "translateY(0)", borderBottomLeftRadius: "50% 10vh", borderBottomRightRadius: "50% 10vh" },
                    { transform: "translateY(-101%)", borderBottomLeftRadius: "50% 0vh", borderBottomRightRadius: "50% 0vh" }
                  ],
                  { duration: 800, easing: EASE_IO, fill: "forwards" }
                )
              );
              resetWipe();
              document.body.style.overflow = "";
              try {
                if (window.__lenis) window.__lenis.start();
              } catch (e) {}
            },
            afterEnter() {
              try {
                ScrollTrigger.refresh();
              } catch (e) {}
            },
          },
        ],
      });
    </script>
  </body>
</html>
