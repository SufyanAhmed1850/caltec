---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.jsx";
import SectionHead from "../components/SectionHead.jsx";
import { FadeUp } from "../components/Reveal.jsx";
---

<Layout
  title="Contact — CALTEC Calibration Technology Services"
  description="Start a service request: share your instruments, ranges, location and turnaround needs. Karachi, Pakistan — nationwide on-site support."
>
  <PageHero
    client:load
    eyebrow="CALTEC / Contact"
    title="Put your next calibration on a clear path."
    lede="Share instruments, ranges, location and turnaround needs — we'll confirm scope, standards and delivery route before anything is booked."
  />

  <section class="relative pb-28 md:pb-40">
    <div class="mx-auto grid max-w-[1600px] gap-14 px-6 md:px-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <FadeUp client:visible>
          <form id="request-form" class="rounded-2xl border hairline bg-[#0b0e13] p-8 md:p-10">
            <p class="label-mono mb-8"><span class="tick">■</span>&nbsp;&nbsp;Service request</p>
            <div class="grid gap-6 sm:grid-cols-2">
              <label class="block">
                <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.2em] text-[#5b636d]">Name *</span>
                <input required name="name" type="text" placeholder="Your name"
                  class="w-full rounded-xl border hairline bg-[#05070a] px-4 py-3.5 text-[15px] text-[#ece9e2] placeholder:text-[#3d454f] outline-none transition-colors focus:border-[#ff5a1f]/60" />
              </label>
              <label class="block">
                <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.2em] text-[#5b636d]">Company *</span>
                <input required name="company" type="text" placeholder="Organisation"
                  class="w-full rounded-xl border hairline bg-[#05070a] px-4 py-3.5 text-[15px] text-[#ece9e2] placeholder:text-[#3d454f] outline-none transition-colors focus:border-[#ff5a1f]/60" />
              </label>
              <label class="block">
                <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.2em] text-[#5b636d]">Email *</span>
                <input required name="email" type="email" placeholder="you@company.com"
                  class="w-full rounded-xl border hairline bg-[#05070a] px-4 py-3.5 text-[15px] text-[#ece9e2] placeholder:text-[#3d454f] outline-none transition-colors focus:border-[#ff5a1f]/60" />
              </label>
              <label class="block">
                <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.2em] text-[#5b636d]">Phone</span>
                <input name="phone" type="tel" placeholder="+92 ..."
                  class="w-full rounded-xl border hairline bg-[#05070a] px-4 py-3.5 text-[15px] text-[#ece9e2] placeholder:text-[#3d454f] outline-none transition-colors focus:border-[#ff5a1f]/60" />
              </label>
              <label class="block sm:col-span-2">
                <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.2em] text-[#5b636d]">Instruments & ranges *</span>
                <textarea required name="instruments" rows="3" placeholder="e.g. 4× pressure transmitters 0–10 bar, 2× RTD indicators…"
                  class="w-full resize-y rounded-xl border hairline bg-[#05070a] px-4 py-3.5 text-[15px] text-[#ece9e2] placeholder:text-[#3d454f] outline-none transition-colors focus:border-[#ff5a1f]/60"></textarea>
              </label>
              <label class="block">
                <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.2em] text-[#5b636d]">Location</span>
                <input name="location" type="text" placeholder="Site city"
                  class="w-full rounded-xl border hairline bg-[#05070a] px-4 py-3.5 text-[15px] text-[#ece9e2] placeholder:text-[#3d454f] outline-none transition-colors focus:border-[#ff5a1f]/60" />
              </label>
              <label class="block">
                <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.2em] text-[#5b636d]">Delivery route</span>
                <select name="route"
                  class="w-full appearance-none rounded-xl border hairline bg-[#05070a] px-4 py-3.5 text-[15px] text-[#ece9e2] outline-none transition-colors focus:border-[#ff5a1f]/60">
                  <option>Advise me</option>
                  <option>Laboratory (send instruments)</option>
                  <option>On-site (come to us)</option>
                </select>
              </label>
              <label class="block sm:col-span-2">
                <span class="mb-2 block font-mono text-[11px] uppercase tracking-[0.2em] text-[#5b636d]">Anything else</span>
                <textarea name="notes" rows="3" placeholder="Turnaround needs, shutdown windows, audit deadlines…"
                  class="w-full resize-y rounded-xl border hairline bg-[#05070a] px-4 py-3.5 text-[15px] text-[#ece9e2] placeholder:text-[#3d454f] outline-none transition-colors focus:border-[#ff5a1f]/60"></textarea>
              </label>
            </div>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <button type="submit" class="btn-signal" data-hover>
                Send service request
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                  <path d="M1 13L13 1M13 1H4M13 1V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              </button>
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[#5b636d]">
                Opens your email client — addressed to CALTEC
              </p>
            </div>
          </form>
        </FadeUp>
      </div>

      <div class="lg:col-span-5">
        <div class="flex flex-col gap-5 lg:sticky lg:top-32">
          <FadeUp client:visible>
            <a href="tel:+923332283557" class="block rounded-2xl border border-[#ff5a1f]/30 bg-[#ff5a1f]/[0.05] p-8 transition-colors hover:border-[#ff5a1f]/60" data-hover>
              <p class="label-mono mb-4"><span class="tick">■</span>&nbsp;&nbsp;Phone</p>
              <p class="font-display text-3xl font-bold tracking-tight text-[#ff5a1f] md:text-4xl">+92 333 22 83557</p>
              <p class="mt-3 text-[15px] text-[#9aa3ad]">Fastest for urgent shutdowns and breakdowns.</p>
            </a>
          </FadeUp>
          <FadeUp client:visible delay={0.08}>
            <a href="https://wa.me/923332283557" target="_blank" rel="noopener" class="block rounded-2xl border hairline bg-[#0b0e13] p-8 transition-colors hover:border-[#37e08b]/40" data-hover>
              <p class="label-mono mb-4"><span class="tick">■</span>&nbsp;&nbsp;WhatsApp</p>
              <p class="font-display text-2xl font-bold tracking-tight">Chat with the team</p>
              <p class="mt-3 text-[15px] text-[#9aa3ad]">Send photos of nameplates and ranges — we'll identify the scope.</p>
            </a>
          </FadeUp>
          <FadeUp client:visible delay={0.16}>
            <div class="rounded-2xl border hairline bg-[#0b0e13] p-8">
              <p class="label-mono mb-4"><span class="tick">■</span>&nbsp;&nbsp;Laboratory</p>
              <p class="font-display text-2xl font-bold tracking-tight">Karachi, Pakistan</p>
              <p class="mt-3 text-[15px] leading-relaxed text-[#9aa3ad]">
                Nationwide on-site support. Local time below — we're on PKT (UTC+5).
              </p>
              <p class="mt-4 font-mono text-[12px] uppercase tracking-[0.18em] text-[#5b636d]">
                Local time — <span id="khi-clock-2" class="tnum text-[#9aa3ad]">--:--:--</span>
              </p>
            </div>
          </FadeUp>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("request-form");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const get = (k) => String(data.get(k) || "").trim();
    const lines = [
      `Name: ${get("name")}`,
      `Company: ${get("company")}`,
      `Email: ${get("email")}`,
      `Phone: ${get("phone") || "-"}`,
      `Location: ${get("location") || "-"}`,
      `Delivery route: ${get("route")}`,
      "",
      "Instruments & ranges:",
      get("instruments"),
      "",
      "Notes:",
      get("notes") || "-",
    ];
    const subject = encodeURIComponent(`Service request — ${get("company") || get("name")}`);
    const body = encodeURIComponent(lines.join("\n"));
    window.location.href = `mailto:info@caltec.com.pk?subject=${subject}&body=${body}`;
  });

  const el = document.getElementById("khi-clock-2");
  const tick = () => {
    if (!el) return;
    el.textContent = new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit", minute: "2-digit", second: "2-digit",
      hour12: false, timeZone: "Asia/Karachi",
    }).format(new Date());
  };
  tick();
  setInterval(tick, 1000);
</script>
