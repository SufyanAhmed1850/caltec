---
import Layout from "../../layouts/Layout.astro";
import CtaBand from "../../components/CtaBand.jsx";
import { FadeUp } from "../../components/Reveal.jsx";
import { POSTS, bySlug } from "../../data/posts.js";

export function getStaticPaths() {
  return POSTS.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = bySlug(slug);
if (!post) throw new Error(`Unknown post: ${slug}`);

const idx = POSTS.findIndex((p) => p.slug === slug);
const next = POSTS[(idx + 1) % POSTS.length];
---

<Layout title={`${post.title} — CALTEC Blog`} description={post.excerpt}>
  <article class="relative pb-28 pt-40 md:pt-52">
    <div class="blueprint blueprint-fade absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[960px] px-6 md:px-12">
      <FadeUp client:load>
        <div class="flex flex-wrap items-center gap-4 font-mono text-[11px] uppercase tracking-[0.2em]">
          <a href="/blog/" class="text-[#ff5a1f] transition-colors hover:text-[#ece9e2]">← Blog</a>
          <span class="text-[#5b636d]">/</span>
          <span class="text-[#5b636d]">{post.category}</span>
          <span class="text-[#5b636d]">·</span>
          <span class="text-[#5b636d]">{post.date}</span>
        </div>
      </FadeUp>
      <FadeUp client:load delay={0.12}>
        <p class="mt-8 text-xl text-[#ff5a1f] md:text-2xl">{post.kicker}</p>
        <h1 class="mt-4 font-display text-4xl font-bold leading-[1.02] tracking-tight md:text-6xl">{post.title}</h1>
      </FadeUp>

      <FadeUp client:load delay={0.2}>
        <div class="mt-16 space-y-8 text-[17px] leading-[1.85] text-[#b6bcc4]">
          {post.body.map((b) =>
            b.t === "h2" ? (
              <h2 class="pt-6 font-display text-3xl font-bold tracking-tight text-[#ece9e2] md:text-4xl">{b.x}</h2>
            ) : b.t === "list" ? (
              <ul class="space-y-5">
                {b.items.map((it) =>
                  typeof it === "string" ? (
                    <li class="flex gap-4"><span class="mt-1 shrink-0 text-[#ff5a1f]">▸</span><span>{it}</span></li>
                  ) : (
                    <li class="flex gap-4"><span class="mt-1 shrink-0 text-[#ff5a1f]">▸</span><span><strong class="font-semibold text-[#ece9e2]">{it.b}:</strong> {it.t}</span></li>
                  )
                )}
              </ul>
            ) : (
              <p>{b.x}</p>
            )
          )}
        </div>
      </FadeUp>

      {/* next post */}
      <FadeUp client:visible>
        <a href={`/blog/${next.slug}/`} class="group mt-20 block rounded-2xl border hairline bg-[#0b0e13] p-8 transition-colors duration-300 hover:border-[#ff5a1f]/40 md:p-10" data-hover>
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-[#5b636d]">Next article</p>
          <h3 class="mt-4 font-display text-2xl font-bold leading-tight tracking-tight transition-colors group-hover:text-[#ff5a1f] md:text-3xl">{next.title}</h3>
        </a>
      </FadeUp>
    </div>
  </article>

  <CtaBand client:visible />
</Layout>
