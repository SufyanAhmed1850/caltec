---
import Layout from "../layouts/Layout.astro";
import Directory from "../components/Directory.jsx";
import SectionHead from "../components/SectionHead.jsx";
import CtaBand from "../components/CtaBand.jsx";
import { FadeUp, Rise } from "../components/Reveal.jsx";
import { DISCIPLINES, bySlug } from "../data/disciplines.js";

export function getStaticPaths() {
  return DISCIPLINES.map((d) => ({ params: { service: d.slug } }));
}

const { service } = Astro.params;
const d = bySlug(service);
if (!d) throw new Error(`Unknown service: ${service}`);

const ASSURANCE = [
  { t: "Define the scope", d: "Instrument, range, location and acceptance needs clarified first." },
  { t: "Control the work", d: "Laboratory and on-site activity follows documented quality processes." },
  { t: "Use the record", d: "Results and documentation organised for your quality files." },
];

const PATH = [
  { n: "01", t: "Scope", d: "Confirm equipment, range, method and acceptance needs." },
  { n: "02", t: "Coordinate", d: "Plan laboratory or on-site delivery around your operation." },
  { n: "03", t: "Complete", d: "Return results and service records to your quality system." },
];

const PREPARE = [
  "Manufacturer, model and instrument ID",
  "Range and required calibration points",
  "Site or laboratory preference",
  "Turnaround, criteria and audit deadline",
];
---

<Layout
  title={`${d.name} Calibration — CALTEC Calibration Technology Services`}
  description={d.tagline}
>
  {/* HERO */}
  <section class="relative overflow-hidden pb-16 pt-40 md:pb-24 md:pt-52">
    <div class="blueprint blueprint-fade absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -top-32 left-1/3 h-[380px] w-[520px] rounded-full bg-[#ff5a1f]/[0.06] blur-[130px]" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[1600px] px-6 md:px-12">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <FadeUp client:load>
            <p class="label-mono mb-8"><span class="tick">■</span>&nbsp;&nbsp;Capability {d.cap} · Calibration service</p>
          </FadeUp>
          <h1 class="font-display text-[12vw] font-bold leading-[0.95] tracking-[-0.02em] sm:text-6xl md:text-8xl">
            <Rise text={`${d.name} calibration`} client:load />
          </h1>
          <FadeUp client:load delay={0.2}>
            <p class="mt-8 max-w-xl text-xl leading-relaxed text-[#ff5a1f]">{d.tagline}</p>
            <p class="mt-4 max-w-xl text-lg leading-relaxed text-[#9aa3ad]">{d.description}</p>
          </FadeUp>
          <FadeUp client:load delay={0.3}>
            <div class="mt-10 flex flex-wrap gap-4">
              <a href="/enquiry/" class="btn-signal" data-hover>Request this service</a>
              <a href="#directory" class="btn-outline" data-hover>Browse instrument coverage</a>
            </div>
          </FadeUp>
        </div>
        <div class="lg:col-span-5">
          <FadeUp client:load delay={0.25}>
            <div class="rounded-2xl border hairline bg-[#0b0e13]/80 p-8 backdrop-blur">
              <div class="flex items-center justify-between">
                <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#5b636d]">{d.name} measurement assurance</p>
                <span class="rounded-full border hairline px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-[#37e08b]">{d.cap} of 07</span>
              </div>
              <ul class="mt-6 space-y-5">
                {ASSURANCE.map((a) => (
                  <li class="flex gap-4">
                    <span class="mt-1 shrink-0 text-[#ff5a1f]">▸</span>
                    <p class="text-[15px] leading-relaxed"><strong class="font-semibold text-[#ece9e2]">{a.t}</strong> <span class="text-[#9aa3ad]">— {a.d}</span></p>
                  </li>
                ))}
              </ul>
            </div>
          </FadeUp>
        </div>
      </div>
    </div>
  </section>

  {/* PATH */}
  <section class="relative border-t hairline bg-[#070a0e] py-24 md:py-32">
    <div class="mx-auto max-w-[1600px] px-6 md:px-12">
      <SectionHead
        client:visible
        kicker="Designed around your operation"
        title="A clear path from requirement to record."
        copy="Send the instrument type, manufacturer, model, working range, location and turnaround requirement. CALTEC will confirm the appropriate capability and delivery route."
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {PATH.map((p, i) => (
          <FadeUp client:visible delay={i * 0.1}>
            <div class="h-full rounded-2xl border hairline bg-[#0b0e13] p-8">
              <p class="font-mono text-[12px] tnum text-[#ff5a1f]">{p.n}</p>
              <h3 class="mt-3 font-display text-2xl font-bold tracking-tight">{p.t}</h3>
              <p class="mt-3 leading-relaxed text-[#9aa3ad]">{p.d}</p>
            </div>
          </FadeUp>
        ))}
      </div>
    </div>
  </section>

  <Directory client:visible instruments={d.instruments} />

  {/* PREPARE */}
  <section class="relative border-t hairline bg-[#070a0e] py-24 md:py-32">
    <div class="mx-auto max-w-[1600px] px-6 md:px-12">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <SectionHead
          client:visible
          kicker="Prepare once"
          title="A better enquiry gets a faster, clearer scope."
        />
        <div>
          <ul class="space-y-0 border-t hairline">
            {PREPARE.map((p, i) => (
              <FadeUp client:visible delay={i * 0.06}>
                <li class="flex items-center gap-5 border-b hairline py-5">
                  <span class="font-mono text-[12px] tnum text-[#ff5a1f]">{String(i + 1).padStart(2, "0")}</span>
                  <span class="text-lg text-[#ece9e2]">{p}</span>
                </li>
              </FadeUp>
            ))}
          </ul>
          <FadeUp client:visible delay={0.2}>
            <a href="/enquiry/" class="btn-signal mt-8" data-hover>Send your requirement</a>
          </FadeUp>
        </div>
      </div>
    </div>
  </section>

  {/* RELATED */}
  <section class="relative py-24 md:py-32">
    <div class="mx-auto max-w-[1600px] px-6 md:px-12">
      <SectionHead
        client:visible
        kicker="Related capabilities"
        title="Keep measurement connected."
        copy="Explore adjacent disciplines or send one consolidated instrument list."
      />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {d.related.map((slug, i) => {
          const r = bySlug(slug);
          return (
            <FadeUp client:visible delay={i * 0.1}>
              <a href={`/${r.slug}/`} class="group block h-full rounded-2xl border hairline bg-[#0b0e13] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#ff5a1f]/40" data-hover>
                <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#5b636d]">Capability {r.cap}</p>
                <h3 class="mt-3 font-display text-2xl font-bold tracking-tight transition-colors group-hover:text-[#ff5a1f]">{r.name} calibration</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-[#9aa3ad]">{r.tagline}</p>
              </a>
            </FadeUp>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBand client:visible />
</Layout>
