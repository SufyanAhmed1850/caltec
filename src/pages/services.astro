---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.jsx";
import SectionHead from "../components/SectionHead.jsx";
import CtaBand from "../components/CtaBand.jsx";
import { FadeUp } from "../components/Reveal.jsx";
import { DISCIPLINES } from "../data/disciplines.js";
---

<Layout
  title="Services — CALTEC Calibration Technology Services"
  description="Seven calibration disciplines: process instruments, electrical, temperature, pressure, dimensional, mass & weighing, and validation support. Laboratory and on-site."
>
  <PageHero
    client:load
    eyebrow="CALTEC / Services"
    title="Calibration scope, end to end."
    lede="Seven focused disciplines covering the instruments your operation depends on — in our laboratory or on your site, with traceable references and audit-ready records."
  />

  <section class="relative pb-28 md:pb-40">
    <div class="mx-auto max-w-[1600px] px-6 md:px-12">
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          DISCIPLINES.map((d, i) => (
            <FadeUp client:visible delay={(i % 3) * 0.1}>
              <article
                id={d.slug}
                class="group relative flex h-full min-h-[380px] scroll-mt-32 flex-col justify-between overflow-hidden rounded-2xl border hairline bg-[#0b0e13] p-8 transition-colors duration-500 hover:border-[#ff5a1f]/40"
                data-hover
              >
                <div
                  class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-[#ff5a1f]/[0.07] blur-[70px] opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                  aria-hidden="true"
                />
                <div>
                  <div class="flex items-center justify-between">
                    <span class="font-mono text-[12px] tnum text-[#5b636d]">
                      {String(i + 1).padStart(2, "0")} / 07
                    </span>
                    <span class="rounded-full border hairline px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-[#5b636d]">
                      Lab + Field
                    </span>
                  </div>
                  <h2 class="mt-8 font-display text-3xl font-bold tracking-tight md:text-4xl">{d.name}</h2>
                  <p class="mt-2 font-mono text-[12px] uppercase tracking-[0.16em] text-[#ff5a1f]">{d.tagline}</p>
                  <p class="mt-5 leading-relaxed text-[#9aa3ad]">{d.description}</p>
                </div>
                <ul class="mt-8 space-y-2 border-t hairline pt-6">
                  {d.points.map((p) => (
                    <li class="flex items-center gap-3 font-mono text-[12px] uppercase tracking-[0.12em] text-[#9aa3ad]">
                      <span class="text-[#ff5a1f]">▸</span> {p}
                    </li>
                  ))}
                </ul>
              </article>
            </FadeUp>
          ))
        }
      </div>

      <div class="mt-20 rounded-2xl border hairline bg-[#070a0e] p-8 md:p-12">
        <SectionHead
          client:visible
          kicker="Scope before promises"
          title="Not sure where your instrument fits?"
          copy="Share the make, model and range — we'll confirm the discipline, the reference standard and the turnaround before anything is booked."
        />
        <a href="/contact" class="btn-signal mt-8" data-hover>
          Ask about your instrument
        </a>
      </div>
    </div>
  </section>

  <CtaBand client:visible />
</Layout>
