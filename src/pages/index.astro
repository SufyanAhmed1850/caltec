---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.jsx";
import LogoMarquee from "../components/LogoMarquee.jsx";
import Disciplines from "../components/Disciplines.jsx";
import LabStandard from "../components/LabStandard.jsx";
import Process from "../components/Process.jsx";
import Certifications from "../components/Certifications.jsx";
import CtaBand from "../components/CtaBand.jsx";
import SectionHead from "../components/SectionHead.jsx";
import { DISCIPLINES, STEPS } from "../data/disciplines.js";
---

<Layout
  title="CALTEC — Calibration Technology Services | Precision that keeps industry moving"
  description="Traceable calibration, instrumentation support and validation for organisations where accuracy, uptime and audit readiness matter. Karachi, Pakistan — nationwide on-site support."
>
  <Hero client:load />

  <section class="relative py-20 md:py-28">
    <div class="mx-auto max-w-[1600px] px-6 md:px-12">
      <SectionHead
        client:visible
        kicker="Trusted in the field"
        title="Supporting teams that cannot afford uncertainty."
        copy="Across pharmaceuticals, manufacturing, food, energy, healthcare and other essential industries."
      />
    </div>
    <div class="mt-12">
      <LogoMarquee client:visible />
    </div>
  </section>

  <Disciplines client:visible items={DISCIPLINES} />
  <LabStandard client:visible />
  <Process client:visible steps={STEPS} />
  <Certifications client:visible />
  <CtaBand client:visible />
</Layout>
