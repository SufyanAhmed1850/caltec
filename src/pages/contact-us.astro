---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.jsx";
import { FadeUp } from "../components/Reveal.jsx";
import { CONTACT, DISCIPLINES } from "../data/disciplines.js";

const CONTACT_BLOCKS = [
  {
    title: "Phones",
    items: [
      { label: "Mobile", value: CONTACT.mobile, href: CONTACT.mobileHref },
      { label: "WhatsApp", value: CONTACT.whatsapp, href: CONTACT.whatsappHref },
      { label: "Landline", value: CONTACT.landline, href: CONTACT.landlineHref },
    ],
  },
  {
    title: "Email",
    items: [
      { label: "General", value: CONTACT.info, href: `mailto:${CONTACT.info}` },
      { label: "Sales", value: CONTACT.sales, href: `mailto:${CONTACT.sales}` },
      { label: "Calibration", value: CONTACT.calibration, href: `mailto:${CONTACT.calibration}` },
    ],
  },
];

const HOURS = [
  { d: "Monday — Friday", h: "9:00 AM — 6:00 PM" },
  { d: "Saturday", h: "9:00 AM — 1:00 PM" },
  { d: "Sunday", h: "Closed" },
];
---

<Layout
  title="Contact Us — CALTEC Calibration Technology Services"
  description="Reach the CALTEC team — Karachi office address, phones, WhatsApp and email."
>
  <PageHero
    client:load
    eyebrow="CALTEC / Contact"
    title="Talk to the team."
    lede="For calibrations, service, spare parts and technical support — reach us by phone, WhatsApp or email."
  />

  <section class="relative pb-28 md:pb-40">
    <div class="mx-auto max-w-[1600px] px-6 md:px-12">
      {/* address card */}
      <FadeUp client:visible>
        <div class="rounded-2xl border hairline bg-[#070a0e] p-8 md:p-12">
          <div class="grid gap-10 md:grid-cols-12">
            <div class="md:col-span-7">
              <p class="label-mono mb-6"><span class="tick">■</span>&nbsp;&nbsp;Head office — Karachi</p>
              <p class="font-display text-2xl font-bold leading-snug tracking-tight md:text-4xl">{CONTACT.address}</p>
              <p class="mt-4 font-mono text-[12px] tracking-[0.14em] text-[#5b636d]">PO Box {CONTACT.poBox}</p>
            </div>
            <div class="md:col-span-5">
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#5b636d]">Office hours</p>
              <ul class="mt-5 space-y-3">
                {HOURS.map((h) => (
                  <li class="flex items-center justify-between border-b hairline pb-3 text-[15px]">
                    <span class="text-[#9aa3ad]">{h.d}</span>
                    <span class="font-mono text-[13px] tnum text-[#ece9e2]">{h.h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </FadeUp>

      {/* contact blocks */}
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {CONTACT_BLOCKS.map((b, i) => (
          <FadeUp client:visible delay={i * 0.1}>
            <div class="h-full rounded-2xl border hairline bg-[#0b0e13] p-8 md:p-10">
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#5b636d]">{b.title}</p>
              <ul class="mt-6 space-y-5">
                {b.items.map((it) => (
                  <li>
                    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[#5b636d]">{it.label}</p>
                    <a href={it.href} class="mt-1 block text-xl font-medium text-[#ece9e2] transition-colors hover:text-[#ff5a1f] md:text-2xl">{it.value}</a>
                  </li>
                ))}
              </ul>
            </div>
          </FadeUp>
        ))}
      </div>

      {/* connect */}
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <FadeUp client:visible delay={0.05}>
          <a href={CONTACT.linkedin} target="_blank" rel="noopener" class="group flex h-full items-center justify-between rounded-2xl border hairline bg-[#0b0e13] p-8 transition-all duration-300 hover:-translate-y-1 hover:border-[#ff5a1f]/40 md:p-10" data-hover>
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#5b636d]">Follow</p>
              <p class="mt-3 font-display text-2xl font-bold tracking-tight">CALTEC on LinkedIn</p>
            </div>
            <span class="grid h-12 w-12 place-items-center rounded-full border hairline text-[#ff5a1f] transition-all duration-300 group-hover:bg-[#ff5a1f] group-hover:text-[#0a0500]">↗</span>
          </a>
        </FadeUp>
        <FadeUp client:visible delay={0.15}>
          <a href="/enquiry/" class="group flex h-full items-center justify-between rounded-2xl border hairline bg-[#ff5a1f] p-8 transition-all duration-300 hover:-translate-y-1 md:p-10" data-hover>
            <div>
              <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[#0a0500]/70">Online</p>
              <p class="mt-3 font-display text-2xl font-bold tracking-tight text-[#0a0500]">Send an enquiry</p>
            </div>
            <span class="grid h-12 w-12 place-items-center rounded-full border border-[#0a0500]/30 text-[#0a0500] transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </FadeUp>
      </div>

      {/* services quick link */}
      <FadeUp client:visible>
        <div class="mt-20 border-t hairline pt-12">
          <p class="label-mono mb-8"><span class="tick">■</span>&nbsp;&nbsp;Seven capabilities, one team</p>
          <div class="flex flex-wrap gap-3">
            {DISCIPLINES.map((d) => (
              <a href={`/${d.slug}/`} class="rounded-full border hairline px-5 py-2.5 font-mono text-[12px] uppercase tracking-[0.14em] text-[#9aa3ad] transition-all hover:border-[#ff5a1f] hover:text-[#ff5a1f]" data-hover>
                {d.name}
              </a>
            ))}
          </div>
        </div>
      </FadeUp>
    </div>
  </section>
</Layout>
