---
import { DISCIPLINES, CONTACT } from "../data/disciplines.js";
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t hairline bg-[#05070a]">
  <div class="mx-auto max-w-[1600px] px-6 pt-16 md:px-12 md:pt-24">
    {/* CTA block */}
    <div class="grid gap-10 border-b hairline pb-16 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="label-mono mb-6"><span class="tick">■</span>&nbsp;&nbsp;Calibration · instrumentation · validation</p>
        <p class="font-display text-4xl font-bold leading-[1.02] tracking-tight md:text-6xl">
          Reliable measurements.<br />Confident decisions.
        </p>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-[#9aa3ad]">
          Tell us what needs to be measured, where it is located and when you need it.
          Our team will help confirm the right scope.
        </p>
      </div>
      <div class="md:col-span-5 md:flex md:items-end">
        <div>
          <a href="/enquiry/" class="btn-signal" data-hover>
            Start an enquiry
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M1 13L13 1M13 1H4M13 1V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </a>
          <p class="mt-5 text-[15px] text-[#5b636d]">On-site and laboratory calibration, instrumentation service and technical support across Pakistan.</p>
        </div>
      </div>
    </div>

    {/* link columns */}
    <div class="grid gap-12 py-16 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="label-mono mb-6"><span class="tick">■</span>&nbsp;&nbsp;Company</p>
        <ul class="space-y-3 font-mono text-[13px] uppercase tracking-[0.14em] text-[#9aa3ad]">
          <li><a href="/about/" class="transition-colors hover:text-[#ff5a1f]">About CALTEC</a></li>
          <li><a href="/business-profile/" class="transition-colors hover:text-[#ff5a1f]">Business profile</a></li>
          <li><a href="/certification/" class="transition-colors hover:text-[#ff5a1f]">Certifications</a></li>
          <li><a href="/blog/" class="transition-colors hover:text-[#ff5a1f]">Blog</a></li>
          <li><a href="/contact-us/" class="transition-colors hover:text-[#ff5a1f]">Contact us</a></li>
        </ul>
      </div>
      <div class="md:col-span-3">
        <p class="label-mono mb-6"><span class="tick">■</span>&nbsp;&nbsp;Services</p>
        <ul class="space-y-3 font-mono text-[13px] uppercase tracking-[0.14em] text-[#9aa3ad]">
          {DISCIPLINES.map((d) => (
            <li><a href={`/${d.slug}/`} class="transition-colors hover:text-[#ff5a1f]">{d.name}</a></li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-6">
        <p class="label-mono mb-6"><span class="tick">■</span>&nbsp;&nbsp;Karachi office</p>
        <p class="max-w-md leading-relaxed text-[#9aa3ad]">{CONTACT.address}</p>
        <div class="mt-6 space-y-2 font-mono text-[13px] tracking-[0.08em]">
          <p><a href={CONTACT.mobileHref} class="text-[#ece9e2] transition-colors hover:text-[#ff5a1f]">{CONTACT.mobile}</a> <span class="text-[#5b636d]">·</span> <a href={CONTACT.landlineHref} class="text-[#9aa3ad] transition-colors hover:text-[#ff5a1f]">{CONTACT.landline}</a></p>
          {CONTACT.emails.map((e) => (
            <p><a href={`mailto:${e.value}`} class="text-[#9aa3ad] transition-colors hover:text-[#ff5a1f]">{e.value}</a></p>
          ))}
        </div>
        <div class="mt-6 flex gap-3">
          <a href={CONTACT.linkedin} target="_blank" rel="noopener" class="btn-outline !py-3 !px-5" data-hover aria-label="CALTEC on LinkedIn">
            LinkedIn
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M1 13L13 1M13 1H4M13 1V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </a>
          <a href={CONTACT.whatsappHref} target="_blank" rel="noopener" class="btn-outline !py-3 !px-5" data-hover aria-label="CALTEC on WhatsApp">
            WhatsApp
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M1 13L13 1M13 1H4M13 1V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </a>
        </div>
      </div>
    </div>

    {/* giant wordmark */}
    <div class="select-none overflow-hidden" aria-hidden="true">
      <p class="font-display text-[18.5vw] font-bold leading-[0.8] tracking-tighter text-white/[0.045] md:text-[16vw]">CALTEC</p>
    </div>

    <div class="flex flex-col gap-3 border-t hairline py-6 font-mono text-[11px] uppercase tracking-[0.18em] text-[#5b636d] md:flex-row md:items-center md:justify-between">
      <span>© {year} Calibration Technology Services</span>
      <span class="flex gap-6">
        <a href="/privacy-policy/" class="transition-colors hover:text-[#ff5a1f]">Privacy policy</a>
        <a href="/contact-us/" class="transition-colors hover:text-[#ff5a1f]">Contact</a>
      </span>
      <span>ISO 9001 · ISO 14001 · ISO 45001</span>
    </div>
  </div>
</footer>
